{
  "name": "ai-video-cut",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "license": "MIT",
  "description": "AI Video Cut — track anything in a video, then blur, replace or add effects; local GPU only, nothing uploaded",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && tsc && eslint src scripts plugins --no-error-on-unmatched-pattern && vite build",
    "lint": "eslint src scripts plugins --no-error-on-unmatched-pattern",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint src scripts plugins --no-error-on-unmatched-pattern && vitest run && node scripts/check-theme-tokens.mjs && node scripts/check-i18n.mjs && node scripts/check-secrets.mjs && vite build",
    "tauri": "tauri",
    "make:app-icon": "node scripts/make-app-icon.mjs",
    "make:screenshots": "node scripts/make-screenshots.mjs",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.41",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.9"
  }
}
